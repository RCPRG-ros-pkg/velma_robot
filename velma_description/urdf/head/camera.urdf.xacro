<?xml version="1.0"?>
<robot xmlns:controller="http://playerstage.sourceforge.net/gazebo/xmlschema/#controller"
                        xmlns:interface="http://playerstage.sourceforge.net/gazebo/xmlschema/#interface"
                        xmlns:sensor="http://playerstage.sourceforge.net/gazebo/xmlschema/#sensor"
                        xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="head_camera" params="name parent *origin">
    <!-- sensor physical attachment -->
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>
    <link name="${name}_link"/>

    <!-- sensor frame -->
    <!-- A revolute joint with 0 limits is required to prevent Gazebo from merging this frame with its parent -->
    <joint name="${name}_optical_frame_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
      <!-- <axis xyz="0 1 0"/> -->
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
      <!-- <limit lower="-0.00001" upper="0.00001" effort="100" velocity="100"/>
      <dynamics damping="0.1"/> -->
    </joint>
    <link name="${name}_optical_frame"/>
  </xacro:macro>

</robot>
