<?xml version="1.0"?>
<robot
  xmlns:controller="http://playerstage.sourceforge.net/gazebo/xmlschema/#controller"
  xmlns:interface="http://playerstage.sourceforge.net/gazebo/xmlschema/#interface"
  xmlns:sensor="http://playerstage.sourceforge.net/gazebo/xmlschema/#sensor"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="collision_detector" default="fcl"/>
  <xacro:property name="collision_detector" value="$(arg collision_detector)"/>

  <xacro:arg name="gravity_compensation" default="true"/>
  <xacro:property name="gravity_compensation" value="$(arg gravity_compensation)"/>

  <xacro:arg name="gripper_mount_type" default="new"/>
  <xacro:property name="gripper_mount_type" value="$(arg gripper_mount_type)"/>

  <xacro:macro name="gripper_mount" params="parent name angle_z">

    <joint name="${name}_gripper_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 ${angle_z}"/>
      <parent link="${parent}"/>
      <child link="${name}_gripper_mount_link"/>
    </joint>

    <link name="${name}_gripper_mount_link">
      <!-- The mount element -->
      <xacro:if value="${gripper_mount_type == 'old'}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://velma_description/meshes/gripper_mount_simplified.stl" />
          </geometry>
          <material name="Orange" >
            <color rgba="1 0.5 0 1.0"/>
          </material>
        </visual>
      </xacro:if>
      <xacro:if value="${gripper_mount_type == 'new'}">
        <visual>
          <origin xyz="0.04 0 0.01" rpy="0.0 0 0" />
          <geometry>
            <box size="0.08 0.08 0.02"/>
          </geometry>
          <material name="Orange" >
            <color rgba="1 0.5 0 1.0"/>
          </material>
        </visual>
        <visual>
          <origin xyz="0 0 0.01" rpy="0 0 0" />
          <geometry>
            <cylinder radius="0.04" length="0.02"/>
          </geometry>
          <material name="Orange" >
            <color rgba="1 0.5 0 1.0"/>
          </material>
        </visual>
      </xacro:if>

      <xacro:if value="${gripper_mount_type == 'minimal'}">
        <visual>
          <origin xyz="0 0 0.01" rpy="0 0 0" />
          <geometry>
            <cylinder radius="0.04" length="0.02"/>
          </geometry>
          <material name="Orange" >
            <color rgba="1 0.5 0 1.0"/>
          </material>
        </visual>
      </xacro:if>

      <xacro:if value="${gripper_mount_type == '45deg'}">
        <visual>
          <origin xyz="0 -0.035 0.01" rpy="0.0 0 0" />
          <geometry>
            <box size="0.08 0.07 0.02"/>
          </geometry>
          <material name="Orange" >
            <color rgba="1 0.5 0 1.0"/>
          </material>
        </visual>
        <visual>
          <origin xyz="0 0 0.01" rpy="0 0 0" />
          <geometry>
            <cylinder radius="0.04" length="0.02"/>
          </geometry>
          <material name="Orange" >
            <color rgba="1 0.5 0 1.0"/>
          </material>
        </visual>

        <visual>
          <origin xyz="0 -0.085 -0.005" rpy="${M_PI/4} 0 0"/>
          <geometry>
            <cylinder radius="0.045" length="0.02"/>
          </geometry>
          <material name="Orange" >
            <color rgba="1 0.5 0 1.0"/>
          </material>
        </visual>

      </xacro:if>

      <!-- IMU case -->
      <visual>
        <origin xyz="0 0 0.04" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.04" length="0.04"/>
        </geometry>
        <!-- <geometry>
          <mesh filename="package://velma_description/meshes/imu_case_right.stl" />
        </geometry> -->
        <material name="Orange" >
          <color rgba="1 0.5 0 1.0"/>
        </material>
      </visual>

      <xacro:unless value="$(arg collision_model_no_hands)">
        <xacro:if value="${collision_detector == 'fcl'}">
          <xacro:if value="${gripper_mount_type == 'old'}">
            <collision>
              <origin xyz="0 0 0" rpy="0 0 0"/>
              <geometry>
                <mesh filename="package://velma_description/meshes/collision/gripper_mount_collision2.STL"/>
              </geometry>
            </collision>
          </xacro:if>

          <xacro:if value="${gripper_mount_type == 'new'}">
            <collision>
              <origin xyz="0.04 0 0.01" rpy="0.0 0 0" />
              <geometry>
                <box size="0.08 0.08 0.02"/>
              </geometry>
            </collision>
            <collision>
              <origin xyz="0 0 0.01" rpy="0 0 0" />
              <geometry>
                <cylinder radius="0.04" length="0.02"/>
              </geometry>
            </collision>
            <!-- IMU case -->
            <collision>
              <origin xyz="0 0 0.04" rpy="0 0 0" />
              <geometry>
                <cylinder radius="0.04" length="0.04"/>
              </geometry>
            </collision>
          </xacro:if>

          <xacro:if value="${gripper_mount_type == 'minimal'}">
            <collision>
              <origin xyz="0 0 0.01" rpy="0 0 0" />
              <geometry>
                <cylinder radius="0.04" length="0.02"/>
              </geometry>
            </collision>
            <!-- IMU case -->
            <collision>
              <origin xyz="0 0 0.04" rpy="0 0 0" />
              <geometry>
                <cylinder radius="0.04" length="0.04"/>
              </geometry>
            </collision>
          </xacro:if>

          <xacro:if value="${gripper_mount_type == '45deg'}">
            <collision>
              <origin xyz="0 -0.035 0.01" rpy="0.0 0 0" />
              <geometry>
                <box size="0.08 0.07 0.02"/>
              </geometry>
            </collision>
            <collision>
              <origin xyz="0 0 0.01" rpy="0 0 0" />
              <geometry>
                <cylinder radius="0.04" length="0.02"/>
              </geometry>
            </collision>
            <!-- IMU case -->
            <collision>
              <origin xyz="0 0 0.04" rpy="0 0 0" />
              <geometry>
                <cylinder radius="0.04" length="0.04"/>
              </geometry>
            </collision>
            <collision>
              <origin xyz="0 -0.085 -0.005" rpy="${M_PI/4} 0 0"/>
              <geometry>
                <cylinder radius="0.045" length="0.02"/>
              </geometry>
            </collision>
          </xacro:if>

        </xacro:if>
        <xacro:if value="${collision_detector == 'dart'}">
          <xacro:if value="${gripper_mount_type == 'old'}">
            <collision>
              <origin xyz="0.00848898105323 0.0 0.0221745967865" rpy="0 0 0"/>
              <geometry>
                <box size="0.110316336155 0.0795853585005 0.0497657060623"/>
              </geometry>
            </collision>
            <collision>
              <origin xyz="0.0838752761483 0 -0.0117062330246" rpy="0 0.822849241182 0"/>
              <geometry>
                <box size="0.068020761013 0.0795853585005 0.025487780571"/>
              </geometry>
            </collision>
            <collision>
              <origin xyz="0.102500602603 0 -0.0791217014194" rpy="0 0 0"/>
              <geometry>
                <box size="0.0187338590622 0.0816289409995 0.100000023842"/>
              </geometry>
            </collision>
          </xacro:if>
          <xacro:if value="${gripper_mount_type == 'new'}">
            <!-- TODO: add new gripper mount -->
          </xacro:if>
        </xacro:if>
      </xacro:unless>

      <xacro:if value="$(arg calibration_needles)">
        <!-- needle -->
        <collision>
          <origin xyz="0 0 0.07" rpy="0 0 0"/>
          <geometry>
            <box size="0.05 0.05 0.14"/>
          </geometry>
        </collision>

        <self_collision_checking>
          <origin xyz="0 0 0.07" rpy="0 0 0"/>
          <geometry>
            <capsule radius="0.025" length="0.09"/>
          </geometry>
        </self_collision_checking>
      </xacro:if>

      <self_collision_checking>
        <origin xyz="0.02 0.0 -0.01" rpy="0 ${M_PI/2.0} 0"/>
        <geometry>
          <capsule radius="0.055" length="0.08"/>
        </geometry>
      </self_collision_checking>

      <inertial>
        <mass value="0.2892125"/>
        <origin rpy="0 0 0" xyz="0.0543534 0.0000315 -0.0313542"/>
        <inertia ixx="0.0007416" ixy="0" ixz="0.000566225" iyy="0.001365025" iyz="0" izz="0.0009347"/>
      </inertial>

      <xacro:visual_marker_xy size="0.02" pos_x="0" pos_y="0" pos_z="0.02" />
    </link>

    <gazebo reference="${name}_gripper_mount_link">
      <turnGravityOff>${gravity_compensation}</turnGravityOff>
      <selfCollide>true</selfCollide>
    </gazebo>

  <link name="${name}_FtSensorLink">
    <inertial>
      <mass value="0.002"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00000520833333333" ixy="0" ixz="0" iyy="0.00000520833333333" iyz="0" izz="0.00000520833333333"/>
    </inertial>
  </link>
  <gazebo reference="${name}_FtSensorLink">
    <turnGravityOff>${gravity_compensation}</turnGravityOff>
    <selfCollide>true</selfCollide>
  </gazebo>

  <!-- TODO: use this joint as FT sensor in Gazebo Sim -->
  <!-- <joint name="${name}FtSensorJoint" type="revolute">
    <parent link="${name}_gripper_mount_link"/>
    <child link="${name}_FtSensorLink"/>
    <origin xyz="0.115 0.0 -0.078" rpy="0 ${M_PI/2} 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="0" upper="0.00001" velocity="3.27"/>
    <dynamics damping="0.05"/>
  </joint>
  <gazebo reference="${name}FtSensorJoint">
    <provideFeedback>true</provideFeedback>
  </gazebo>
-->

  <joint name="${name}FtSensorJoint" type="fixed">
    <parent link="${name}_gripper_mount_link"/>
    <child link="${name}_FtSensorLink"/>
    <xacro:if value="${gripper_mount_type == 'old'}">
      <origin xyz="0.115 0.0 -0.078" rpy="0 ${M_PI/2} 0"/>
    </xacro:if>
    <xacro:if value="${gripper_mount_type == 'new'}">
      <origin xyz="0.08 0.0 0.0" rpy="0 ${M_PI/2} 0"/>
    </xacro:if>
    <xacro:if value="${gripper_mount_type == 'minimal'}">
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </xacro:if>
    <xacro:if value="${gripper_mount_type == '45deg'}">
      <origin xyz="0 -0.09 0" rpy="${M_PI/4} 0 0"/>
    </xacro:if>
  </joint>

  </xacro:macro>
</robot>
