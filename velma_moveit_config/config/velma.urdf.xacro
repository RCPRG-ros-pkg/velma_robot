<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="velma">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import velma urdf file -->
    <xacro:include filename="$(find velma_description)/urdf/velma.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="velma.ros2_control.xacro" />


    <xacro:velma_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
